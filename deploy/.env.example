# 复制成 deploy/.env 再填写。这个文件里有密钥，不要提交到 git、不要发给别人。
# 填好后执行：chmod 600 deploy/.env

# 你的域名（先把域名的 A 记录指向服务器 IP）
DOMAIN=memo.example.com

# 用户数据加密主密钥：生成一次，永远不要改，也不要丢（丢了数据就再也解不开了）
# 生成方法：openssl rand -base64 32
DATA_KEY=

# AI 服务的 Key，变量名要和 models.json 里的 key_env 对应，并且必须以 _API_KEY 结尾
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 以下可选
# 每人每天最多调用 AI 多少次
LLM_DAILY_LIMIT=300
# 每人每分钟最多调用 AI 多少次
LLM_PER_MINUTE=20
# 登录有效期（天），以及多少天不用自动退出
SESSION_DAYS=30
SESSION_IDLE_DAYS=7
