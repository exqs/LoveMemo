# 复制成 deploy/.env 再填写。这个文件里有密钥，不要提交到 git、不要发给别人。
# 填好后执行：chmod 600 deploy/.env

# 访问方式，三选一（详细步骤和注意事项见 deploy/DEPLOY.md）：
#   https-ip  默认。用 https://服务器IP:端口 访问，不需要域名。
#             会向 Let's Encrypt 申请 IP 证书（要求 80 端口能从公网访问），
#             申请不到时改用自签名证书，浏览器会提示"不安全"，需要手动信任一次
#   https     用 https://域名 访问，自动申请证书。要求 80、443 端口能从公网访问；
#             服务器在中国大陆的话，域名必须先备案，否则云厂商会拦截
#   http      不加密，不需要证书，只用 80 端口。密码、聊天记录、API Key 都是明文传输，
#             只适合内网或临时测试
# 改了这一项之后要先 down 再 up（见 DEPLOY.md「切换访问方式」）
COMPOSE_PROFILES=https-ip

# --- https-ip 方式填这两项 ---
# 服务器的公网 IPv4 地址（云服务器控制台里的"公网 IP"）
SERVER_IP=
# 访问端口，大家用 https://SERVER_IP:HTTPS_PORT 打开。不能是 80
HTTPS_PORT=8443

# --- https 或 http 方式填这一项 ---
# 访问地址里的域名（先把 A 记录指向服务器 IP）。http 方式也可以填 IP。不要带 http://、端口或路径
DOMAIN=

# 加密主密钥（加密所有人的数据和网页上填的 API Key）：生成一次，永远不要改，也不要丢（丢了数据就再也解不开了）
# 生成方法：openssl rand -base64 32
DATA_KEY=

# 以下可选
# AI 服务商和 API Key 不在这里配置：用管理员登录网页，在「管理 → AI 模型」里添加
# 允许 AI 端点地址指向内网或本机（例如自己部署的 Ollama）。不用的话保持注释
# ALLOW_PRIVATE_LLM_HOSTS=1
# 每人每天最多调用 AI 多少次
LLM_DAILY_LIMIT=300
# 每人每分钟最多调用 AI 多少次
LLM_PER_MINUTE=20
# 登录有效期（天），以及多少天不用自动退出
SESSION_DAYS=30
SESSION_IDLE_DAYS=7
