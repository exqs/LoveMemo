# 复制成 deploy/.env 再填写。这个文件里有密钥，不要提交到 git、不要发给别人。
# 填好后执行：chmod 600 deploy/.env

# 访问方式，二选一（详细说明见 deploy/DEPLOY.md）：
#   https  推荐。自动申请免费证书，传输加密。需要域名，并且 80、443 端口能从公网访问；
#          服务器在中国大陆的话，域名还必须先备案，否则云厂商会拦截
#   http   不加密，不需要证书，只用 80 端口。密码、聊天记录、API Key 都是明文传输，
#          只适合内网或临时测试
# 改了这一项之后要先 down 再 up（见 DEPLOY.md「切换访问方式」）
COMPOSE_PROFILES=https

# 访问地址里的域名（https 模式必须是域名，先把 A 记录指向服务器 IP）。
# http 模式也可以填服务器的 IP。不要带 http://、端口或路径
DOMAIN=memo.example.com

# 加密主密钥（加密所有人的数据和网页上填的 API Key）：生成一次，永远不要改，也不要丢（丢了数据就再也解不开了）
# 生成方法：openssl rand -base64 32
DATA_KEY=

# 以下可选
# AI 服务商和 API Key 不在这里配置：用管理员登录网页，在「管理 → AI 模型」里添加
# 允许 AI 端点地址指向内网或本机（例如自己部署的 Ollama）。不用的话保持注释
# ALLOW_PRIVATE_LLM_HOSTS=1
# 每人每天最多调用 AI 多少次
LLM_DAILY_LIMIT=300
# 每人每分钟最多调用 AI 多少次
LLM_PER_MINUTE=20
# 登录有效期（天），以及多少天不用自动退出
SESSION_DAYS=30
SESSION_IDLE_DAYS=7
